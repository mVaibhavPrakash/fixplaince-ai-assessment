NODE_ENV=development
PORT=4000
PG_HOST=127.0.0.1
PG_PORT=5432

PG_USERNAME=postgres
PG_PASSWORD=replace-with-your-local-password
PG_RUNTIME_USERNAME=taskboard_runtime
# Optional: use a separate local runtime password; defaults to PG_PASSWORD if omitted.
# PG_RUNTIME_PASSWORD=replace-with-your-runtime-password
PG_DATABASE=taskboard
PG_TEST_DATABASE=taskboard_test
